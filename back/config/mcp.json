{
  "mcpServers": {
    "agents-platform-runners": {
      "args": [
        "-m",
        "agents_platform_runners_app.mcp_server"
      ],
      "command": "python3",
      "cwd": "/workspace/apps/agents-platform-runners",
      "enabled": true,
      "env": {
        "AGENTS_BASE": "http://172.18.0.1:10014",
        "AGENTS_PLATFORM_TOKEN": "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMSIsIm1lbWJlcnNoaXBzIjpbeyJ3b3Jrc3BhY2UiOiJhdyIsInJvbGUiOiJvd25lciJ9XSwiaWF0IjoxNzg1NjMwMTk0LCJleHAiOjE5NDMzMTAxOTR9.f7e7XElHd8Od-rRNSyJ6twux2b2DtJZjZFKyG4vTlvbweURSdH8I-gb7G2QhaovZWrkkH--cLqkamkNjcRQiAg"
      },
      "type": "stdio"
    },
    "aw-presentation": {
      "enabled": true,
      "headers": {
        "X-Api-Key": "e5b0098c1207c8e80b9121418af572a517827de37617cc7b8c9ee6e9df013db6"
      },
      "type": "http",
      "url": "http://8d1e528a762c:9030/api/apps/presentations/mcp"
    },
    "codegraphcontext": {
      "args": [
        "mcp",
        "start"
      ],
      "command": "/opt/aw-workspace/apps/codegraphcontext/.data/venv/bin/cgc",
      "enabled": true,
      "type": "stdio"
    },
    "devctl-browser": {
      "args": [
        "-m",
        "mcp_server.devctl_browser"
      ],
      "command": "python3",
      "enabled": true,
      "type": "stdio"
    },
    "example-echo": {
      "_comment": "A real, trivial stdio MCP server enabled by default so a fresh checkout has one working local upstream. Add custom servers here or through the app settings UI.",
      "args": [
        "-m",
        "gateway.examples.echo_server"
      ],
      "command": "python3",
      "enabled": true,
      "type": "stdio"
    },
    "example-leaf-gateway": {
      "_comment": "type='gateway' federates another aw-mcp-gateway's tool pool into this one. Enable it and add it to gateway.json upstreams once you have a real remote.",
      "enabled": false,
      "token": "the-other-gateway's-bearer-token",
      "type": "gateway",
      "url": "http://127.0.0.1:9201/mcp"
    },
    "kb": {
      "enabled": true,
      "type": "http",
      "url": "http://aw-app-kb:8000/mcp"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@0.0.77",
        "--cdp-endpoint",
        "http://aw-app-browser:9223"
      ],
      "command": "npx",
      "enabled": true,
      "type": "stdio"
    },
    "vscode": {
      "args": [
        "-m",
        "mcp_server.server"
      ],
      "command": "python3",
      "cwd": "/workspace/apps/code-server",
      "enabled": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "type": "stdio"
    },
    "whiteboard": {
      "enabled": true,
      "headers": {
        "X-Api-Key": "e5b0098c1207c8e80b9121418af572a517827de37617cc7b8c9ee6e9df013db6"
      },
      "type": "http",
      "url": "http://8d1e528a762c:9030/api/apps/whiteboard/mcp"
    }
  }
}
